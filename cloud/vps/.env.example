# Copy to cloud/vps/.env and fill in.

# DNS A/AAAA records for BOTH names must point at this server before you start.
APP_DOMAIN=jobs.example.com
API_DOMAIN=api.jobs.example.com
# Used by Let's Encrypt for expiry notices.
ACME_EMAIL=you@example.com

# JobEscape has no login. Restrict who can reach it: space-separated IPs or CIDR ranges,
# e.g. ALLOWED_IPS=203.0.113.7 198.51.100.0/24   (default allows everyone)
ALLOWED_IPS=0.0.0.0/0 ::/0

# Optional scraper settings
MAX_CONCURRENT_JOBS=2
MAX_PARALLEL_TASKS=12
MAX_TASKS_PER_JOB=150
JOB_TTL_SECONDS=3600
# Rotating proxies, comma-separated (user:pass@host:port,...)
SCRAPER_PROXIES=
